# Conductor. Пустая строка = «не задано»: бот возьмёт умолчание.
# Оба токена живут в этом файле. BOT_MODE выбирает, какой токен и какой
# список серверов возьмёт ЭТОТ процесс. Оба сразу из одного файла не стартуют.
# Второй контейнер одновременно: скопируйте файл в .env.test (см. docs/SETUP.md).

# --- какой бот запускать ---
# live — основной. test или beta — тестовый.
BOT_MODE=live

# --- основной бот (когда BOT_MODE=live) ---
DISCORD_TOKEN=your-bot-token
# Серверы через запятую. С любых других этот бот выйдет сам.
GUILD_IDS=
# Запасной id, если GUILD_IDS пуст.
PUBLIC_GUILD_ID=

# --- тестовый бот (когда BOT_MODE=test или beta) ---
TEST_DISCORD_TOKEN=
TEST_GUILD_IDS=
# Запасной id, если TEST_GUILD_IDS пуст. Иначе в test/beta читается GUILD_IDS.
TEST_GUILD_ID=

# --- кто считается разработчиком ---
# Кроме владельца приложения Discord. Через запятую.
OWNER_USER_IDS=

# --- логи ---
# CRITICAL | ERROR | WARNING | INFO | DEBUG. Незнакомое значение = INFO.
LOG_LEVEL=INFO

# --- данные и база (локально без Docker) ---
# Пусто = <корень проекта>/data. От него — SQLite, .command-hash, automod.yml, .heartbeat.
# В docker compose игнорируется: контейнер пишет в /app/data (= ./data на хосте).
DATA_DIR=
# Локально без Docker. Относительный путь — целиком относительно DATA_DIR.
# Префикс data/ не дублируется (`./data/conductor.db` → DATA_DIR/conductor.db).
# :memory: — база в памяти, не файл.
# В docker compose не используется: URL собирается из POSTGRES_* ниже.
DATABASE_URL=sqlite+aiosqlite:///./data/conductor.db

# --- Docker / Postgres ---
# Пароль обязателен для compose. Лучше латиница и цифры.
POSTGRES_USER=conductor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=conductor
# На хосте Postgres слушает только 127.0.0.1:этот-порт.
POSTGRES_PORT=5432
TZ=Europe/Moscow

# --- кэш и хранение ---
# Сообщений в памяти для логов правок и удалений.
MESSAGE_CACHE_SIZE=20000
# Срок жизни текста в кэше, секунды. По умолчанию 1 час.
MESSAGE_CACHE_TTL=3600
# Производные таблицы (дневные счётчики, связи, голосовые сессии, события репутации без дела), дни. 0 = не чистить.
DATA_RETENTION_DAYS=90
# Транскрипты тикетов, дни. 0 = не чистить.
TICKET_TRANSCRIPT_DAYS=365
# Снимки SQLite (VACUUM INTO) рядом с базой. 0 = не снимать.
# Полная копия живой базы: restore вернёт забытых. Не для GDPR. На Postgres не пишется.
SQLITE_BACKUP_KEEP=7

# --- лимиты ---
VOICE_ROOMS_PER_MEMBER=1
TICKETS_PER_CATEGORY=1
INTERACTION_LIMIT_PER_MINUTE=50
# Потолок нажатий на гильдию в минуту. 50 = взять из RATE_PROFILE (edge: 1200).
# Окно на участника задаёт профиль (edge 12 / 10 с), не этот ключ.
# Темп REST: edge (у границы Discord), balanced, safe. Пусто = edge.
RATE_PROFILE=edge
# Переопределения профиля. Пусто = взять из RATE_PROFILE.
# Глобальный потолок Discord — 50 запросов/с на бота; взаимодействия в него не входят.
GLOBAL_RPS_TARGET=
# Сколько исходящих REST сразу. INTERACTION вне этого числа.
OUTBOUND_CONCURRENCY=
# Сколько discord.py может ждать 429 внутри вызова, секунды. Не ставьте пусто как «без потолка».
MAX_RATELIMIT_WAIT=
# При стольких недопустимых запросах за 10 мин остановить USER/STAFF/BACKGROUND.
INVALID_REQUEST_STOP=

# --- запуск ---
# Пусто или false — синхронизировать слэш-команды, только если дерево изменилось (DATA_DIR/.command-hash).
FORCE_SYNC=false
# Пусто = true для SQLite, false для Postgres.
# На Postgres задайте true или выполните `conductor db upgrade` до старта.
# Если false — бот не стартует, пока ревизия БД не равна head.
# Docker Compose подставляет true, если ключ пустой.
AUTO_MIGRATE=
