# Скопируйте блок в C:\Users\<вы>\.ssh\config на Windows.
# Затем в PowerShell: ssh conductor
#
# HostName — публичный IPv4 сервера.
# User — тот, кого создали на Ubuntu (часто ubuntu).
# IdentityFile — приватный ключ, который сгенерировали на Windows.

Host conductor
  HostName 203.0.113.10
  User ubuntu
  IdentityFile ~/.ssh/conductor
  IdentitiesOnly yes
