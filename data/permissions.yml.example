# Начальная загрузка и резервная копия. Источник правды — база гильдии.
# /admin import заливает этот файл в БД, экспорт — кнопка на странице «Права».
# Справа — ранги, не снежинки ролей.

ranks:
  special: []          # снежинки ролей; special выдаётся только вручную в Discord
  chief: []
  senior: []
  watcher: []

